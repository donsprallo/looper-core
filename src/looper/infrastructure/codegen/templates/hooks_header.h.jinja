/*
 * Generated by looper {{ version }}. Do not edit.
 *
 * One hook per adapter function. A hook that is NULL makes the adapter fall
 * back to its default behaviour: it returns the zero value of its return type
 * and zeroes the output parameters that the contract marks as written on
 * return.
 */
#ifndef LOOPER_HOOKS_H
#define LOOPER_HOOKS_H

#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>

{% for header in view.header_names -%}
#include "{{ header }}"
{% endfor %}
/*
 * Call recording is opt in. Build with -DLOOPER_JOURNAL and link the looper
 * runtime to record every adapter call; without it the generated sources have
 * no dependency on the runtime at all.
 */
#ifdef LOOPER_JOURNAL
#include "looper_journal.h"
#include "looper_timing.h"
#define LOOPER_RECORD(function_name) looper_journal_record(function_name)
#define LOOPER_TIMING_ENTER(function_name) looper_timing_enter(function_name)
#define LOOPER_TIMING_LEAVE(function_name, started, answered)     looper_timing_leave(function_name, started, answered)
#else
#define LOOPER_RECORD(function_name) ((void)0)
#define LOOPER_TIMING_ENTER(function_name) 0u
#define LOOPER_TIMING_LEAVE(function_name, started, answered)     ((void)(started), (void)(answered))
#endif

#ifdef __cplusplus
extern "C" {
#endif

{% for function in view.functions %}
/**
 * @brief Hook replacing {{ function.name }}().
{%- for note in function.contract_notes %}
 * @param {{ note }}
{%- endfor %}
 */
typedef {{ function.return_type }} (*{{ function.hook_type_name }})({{ function.parameter_list }});
{% endfor %}
/** @brief Every hook of the simulated adapter surface. */
typedef struct {
{%- for function in view.functions %}
    {{ function.hook_type_name }} {{ function.name }};
{%- endfor %}
} looper_hooks_t;

/**
 * @brief Access the hook table shared by every generated adapter.
 * @return Pointer to the table. It is never NULL.
 */
looper_hooks_t *looper_hooks(void);

/** @brief Clear every hook, restoring the default behaviour. */
void looper_hooks_reset(void);

#ifdef __cplusplus
}
#endif

#endif /* LOOPER_HOOKS_H */

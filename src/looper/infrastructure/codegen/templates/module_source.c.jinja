/*
 * Generated by looper {{ version }} from {{ module.header_name }}. Do not edit.
 */
#include "{{ module.header_name }}"

#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>

#include "looper_hooks.h"
{%- if module.binding_headers %}
#include "looper_binding.h"
{%- for header in module.binding_headers %}
#include "{{ header }}"
{%- endfor %}
{%- endif %}
{% for symbol in module.extern_data %}
/*
 * Define {{ symbol.initializer_macro }} before building this file to give the
 * exported symbol real content. Without it the symbol is zero initialised, so
 * the simulation links but the table dispatches nowhere.
 */
#ifndef {{ symbol.initializer_macro }}
#define {{ symbol.initializer_macro }} {0}
#endif

{{ symbol.declarator }} = {{ symbol.initializer_macro }};
{% endfor %}
{%- for function in module.functions %}

/*
 * The body, wrapped below so that the call can be timed in one place.
 *
 * A function with several ways out would otherwise need the measurement
 * repeated at each of them, and one forgotten return would quietly make
 * the numbers wrong.
 */
static {{ function.return_type }} looper_body_{{ function.name }}({{ function.parameter_list }})
{
    const looper_hooks_t *looper_table = looper_hooks();

    if (looper_table->{{ function.name }} != NULL) {
{%- if function.default_return is none %}
        looper_table->{{ function.name }}({{ function.argument_list }});
        return;
{%- else %}
        return looper_table->{{ function.name }}({{ function.argument_list }});
{%- endif %}
    }
{%- if function.binding is not none %}

    /*
     * Contract: this is {{ function.binding.description }}.
     *
     * Which bus and which address depends on the board, which says so with
     * looper_binding_bind, or leaves it to the only bus of the kind.
     */
    {
        uint32_t {{ binding_bus }} = 0u;
        uint32_t {{ binding_address }} = 0u;

        if (looper_binding_resolve(
                {{ function.binding.instance }},
                {{ function.binding.bus_kind }},
                &{{ binding_bus }},
                &{{ binding_address }}
            )) {
            return {{ function.binding.call }};
        }
    }
{%- endif %}
{%- for reset in function.output_resets %}

    /* Contract: {{ reset.name }} is written before this call returns. */
    if ({{ reset.name }} != NULL) {
        *{{ reset.name }} = {{ reset.zero_expression }};
    }
{%- endfor %}
{%- if function.default_return is not none %}

    return {{ function.default_return }};
{%- endif %}
}

{{ function.return_type }} {{ function.name }}({{ function.parameter_list }})
{
    const uint64_t looper_started = LOOPER_TIMING_ENTER("{{ function.name }}");
    /*
     * Whether anything implements this call, or whether the firmware is
     * about to be handed the zero value and believe it.
     */
    const bool looper_answered = {{ function.answered_expression }};
{%- if function.default_return is not none %}
    {{ function.return_type }} looper_result;
{%- endif %}

    LOOPER_RECORD("{{ function.name }}");
{%- if function.default_return is none %}
    looper_body_{{ function.name }}({{ function.argument_list }});
    LOOPER_TIMING_LEAVE("{{ function.name }}", looper_started, looper_answered);
{%- else %}
    looper_result = looper_body_{{ function.name }}({{ function.argument_list }});
    LOOPER_TIMING_LEAVE("{{ function.name }}", looper_started, looper_answered);
    return looper_result;
{%- endif %}
}
{%- endfor %}
